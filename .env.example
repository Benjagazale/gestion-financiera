# Copia a .env y completa los valores (nunca commitear .env real)
# Supabase: Dashboard → Connect → Connection string (modo Session, puerto 6543)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_PROYECTO.pooler.supabase.com:6543/postgres

# Groq: console.groq.com/keys
GROQ_API_KEY=TU_CLAVE_GROQ

# Vacío = auth deshabilitada (solo dev local). En producción SIEMPRE definido.
API_KEY=

# Identidad transitoria hasta Supabase Auth (FASE 3)
DEFAULT_USER_ID=1

# Normalización USD → CLP (tasa fija configurable)
FX_USD_CLP=950

# Rate limiting de los endpoints de IA
PARSE_RATE_LIMIT=10
RATE_WINDOW_SECONDS=60

# Dominios permitidos (coma separada); en prod, el dominio del frontend
CORS_ORIGINS=*
